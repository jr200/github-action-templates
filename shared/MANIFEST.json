{
  "$schema": "./MANIFEST.schema.json",
  "_comment": "Declares files synced from this repo's shared/ dir into consumer repos. Changes here are released through shared-v* refs and GitHub Releases. See sync.sh. Three destination modes: cache (→ .shared/, gitignored, re-fetched in CI), committed (→ repo root, tracked, drift-checked), and merged (→ repo root, tracked, drift-checked; deep-merged via yq with optional repo-local override file).",
  "common": {
    "committed": [".githooks/commit-msg", ".githooks/lint-message-text.sh", "cog.toml"],
    "cache": ["lint-release-please-config.sh"],
    "merged": [
      {
        "source": "release-please-config.base.json",
        "local": ".release-please.local.json",
        "target": "release-please-config.json"
      }
    ]
  },
  "python": {
    "cache": ["ruff.toml"],
    "merged": [
      {
        "source": "pre-commit-config.python.base.yaml",
        "local": ".pre-commit-config.local.yaml",
        "target": ".pre-commit-config.yaml"
      }
    ]
  },
  "node": {
    "cache": ["eslint.config.mjs"],
    "merged": [
      {
        "source": "syncpack/.syncpackrc.base.yaml",
        "local": ".syncpackrc.local.yaml",
        "target": ".syncpackrc.yaml"
      },
      {
        "source": "pre-commit-config.node.base.yaml",
        "local": ".pre-commit-config.local.yaml",
        "target": ".pre-commit-config.yaml"
      }
    ]
  },
  "go": {
    "cache": [".golangci.yml"],
    "merged": [
      {
        "source": "pre-commit-config.go.base.yaml",
        "local": ".pre-commit-config.local.yaml",
        "target": ".pre-commit-config.yaml"
      }
    ]
  },
  "docker": {
    "cache": [".hadolint.yaml"]
  }
}
